# Скопируйте в .env и поправьте под проект: cp .env.example .env  (или make init)
# Файл .env в репозиторий не попадает (см. .gitignore) — секреты храните только в нём.

# Имя проекта: префикс контейнеров и docker-томов.
COMPOSE_PROJECT_NAME=app

# Активные профили compose. Пусто — обычный запуск; `ssl` добавляет контейнер
# автопродления сертификата. Значение выставляет make ssl, вручную не нужно.
COMPOSE_PROFILES=

# ---------- Приложение ----------
APP_ENV=production
APP_HOST=localhost
APP_PORT=80
APP_SSL_PORT=443

# Максимальный размер загружаемого файла для nginx и phpMyAdmin.
# PHP читает лимит из docker/php/conf.d/custom.ini — меняйте оба значения вместе.
UPLOAD_LIMIT=256M

# ---------- nginx ----------
# Профиль конфига (переключается автоматически через make ssl):
#   ./docker/nginx/templates/http   — без TLS, работает сразу (dev, первый запуск)
#   ./docker/nginx/templates/https  — редирект на HTTPS + TLS (нужен сертификат)
NGINX_TEMPLATES=./docker/nginx/templates/http

# ---------- SSL / Let's Encrypt ----------
# Выпуск сертификата: make ssl (перед этим — make ssl-test для проверки).
# Продление автоматическое, вручную — make ssl-renew.

# Обязателен для make ssl: на этот адрес Let's Encrypt шлёт уведомления
# об истечении сертификата.
SSL_EMAIL=

# Домены в сертификате. По умолчанию APP_HOST и www.APP_HOST.
# Раскомментируйте, чтобы задать свой список (через запятую).
#SSL_DOMAINS=example.com,www.example.com

# Куда certbot кладёт сертификаты и откуда их читает nginx.
# Менять нужно, только если сертификаты выпущены на хосте: SSL_CERTS_DIR=/etc/letsencrypt
SSL_CERTS_DIR=./docker/nginx/certs

# ---------- PHP ----------
PHP_VERSION=8.4

# UID/GID пользователя хоста — под ними внутри контейнера работает php-fpm.
# Именно из-за несовпадения этих значений PHP обычно «не может писать файлы»:
# по умолчанию в alpine он работает от UID 82, а файлы проекта принадлежат вам.
# Правильные значения подставляет `make init` (id -u / id -g).
# После изменения нужна пересборка образа: make rebuild
UID=1000
GID=1000
# off | debug | develop | coverage | profile (можно через запятую: debug,develop)
XDEBUG_MODE=off

# ---------- База данных ----------
# ВНИМАНИЕ: перед деплоем замените пароли на стойкие случайные значения.
# Сгенерировать: openssl rand -base64 24
# Не используйте в значениях символы # и $ — этот файл читают и docker compose,
# и Makefile, для них они имеют специальный смысл.
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too

MARIADB_VERSION=lts

# ---------- Почта ----------
# По умолчанию письма перехватывает Mailpit и наружу они НЕ уходят.
# Для реальной отправки укажите здесь боевой SMTP.
MAIL_HOST=mailpit
MAIL_PORT=1025

# ---------- Служебные порты ----------
# Привязаны к 127.0.0.1 (см. docker-compose.yaml) — снаружи доступны только 80/443.
# Доступ к ним с локальной машины — через SSH-туннель.
MARIADB_PORT=3306
REDIS_PORT=6379
PMA_PORT=8080
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
